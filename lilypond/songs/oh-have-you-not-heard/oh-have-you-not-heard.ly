verseA = \lyricmode {
\l Oh, have you not heard of that beau -- ti -- ful stream that
\l flows through the prom -- ised land?
\l Its wa -- ters gleam bright in the heav -- en -- ly light, and
\l rip -- ple o'er gold -- en sand.
  %% REFRAIN
  %% 4verse.ily passes "1" as the laterLabel, so the stanza number repeats
  %% at the start of every system - including the refrain, which belongs to
  %% no one stanza. Clear it here so the refrain systems carry no number, as
  %% the page prints them. \SO keeps this out of the slides.
  \SO { \set shortVocalName = "" }
\l O seek that beau -- ti -- ful stream, O seek that beau -- ti -- ful stream.
\l Its wa -- ters, so free, are flow -- ing for thee,
\l O seek that beau -- ti -- ful stream.
  %% END REFRAIN
}
verseB = \lyricmode {
\l Its foun -- tains are deep and its wa -- ters are pure, and
\l sweet to the wea -- ry soul.
\l It flows from the throne of Je -- ho -- vah a -- lone! O
\l come where its bright waves roll.
  %% REFRAIN
  \SB {
    O seek that beau -- ti -- ful stream, O seek that beau -- ti -- ful stream.
    Its wa -- ters, so free, are flow -- ing for thee,
    O seek that beau -- ti -- ful stream.
  } \SO {
    _ _ _ _ _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _
  }
  %% END REFRAIN
}
verseC = \lyricmode {
\l This beau -- ti -- ful stream is the riv -- er of life! It
\l flows for all na -- tions free!
\l A balm for each wound in its wa -- ter is found; O
\l sin -- ner, it flows for thee!
  %% REFRAIN
  \SC {
    O seek that beau -- ti -- ful stream, O seek that beau -- ti -- ful stream.
    Its wa -- ters, so free, are flow -- ing for thee,
