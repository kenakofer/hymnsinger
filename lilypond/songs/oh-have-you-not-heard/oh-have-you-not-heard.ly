  } \SO {
    _ _ _ _ _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _
  }
  %% END REFRAIN
}
verseD = \lyricmode {
\l Oh, will you not drink of this beau -- ti -- ful stream, and
\l dwell on its peace -- ful shore?
\l The Spir -- it says: Come, all ye wea -- ry ones, home, and
\l wan -- der in sin no more.
  %% REFRAIN
  \SD {
