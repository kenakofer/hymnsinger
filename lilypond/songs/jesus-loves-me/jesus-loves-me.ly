%% One \l per system. The refrain begins on the third line (m9), where
%% the page prints its "Refrain" marker.
verseA = \lyricmode {
\l Je -- sus loves me! this I know, for the Bi -- ble tells me so.
\l Lit -- tle ones to him be -- long, they are weak, but he is strong.
\l Yes, Je -- sus loves me. Yes, Je -- sus loves me.
\l Yes, Je -- sus loves me; the Bi -- ble tells me so.
}

%% The page prints four translations below the score, in two columns:
%% Spanish and Hausa on the left, Korean and Navajo on the right. They
%% are laid out here the same way. The source .mscx carries them as two
%% free Text blocks, which the converter drops with the rest of its
%% StaffText handling, so they are transcribed from the source text and
%% checked against a zoom of the page.
%%
%% Each language gets its verse and then its refrain, as the page has
%% them. They are NOT underlaid: the hymnal sets them as text below the
%% staff, not under the notes, and 16 measures will not carry five
%% languages of underlay.
%%
%% Spelling follows the PAGE where it and the source disagree:
%%   - Navajo "shil" in the source is "shił" (barred l) on the page.
%%   - "Su palabra dice así." takes the period the source omits.
%% The Navajo refrain's second line really does read "ayoo'ashó'ní"
%% without the accents that lines 1 and 3 carry - that asymmetry is the
%% hymnal's own and is reproduced rather than normalized.
%%
%% See the commit message on the translations' copyright status.
extra_verses = \markup {
  \fontsize #-2.5
  \fill-line {
    \hspace #-3.0
    \column {
      \line { \bold "SPANISH" }
      \combine \null \vspace #0.3
      \column {
"Cristo me ama, me ama a mí."
"Su palabra dice así."
"Niños pueden ir a él,"
"Quien es nuestro amigo fiel."
      }
      \combine \null \vspace #0.4
      \column {
"Sí, Cristo me ama."
"Sí, Cristo me ama."
"Sí, Cristo me ama,"
"La Biblia dice así."
      }
      \combine \null \vspace #0.7
      \line { \bold "HAUSA" }
      \combine \null \vspace #0.3
      \column {
"Yesu yana kaunarmu,"
"Wannan na sakankance."
"Gaskiyarsa ta tabbata,"
"Allah ne ya shaida shi."
      }
      \combine \null \vspace #0.4
      \column {
"I, yana sonmu, i, yana sonmu,"
"I, yana sonmu, Yesu Mai Centonmu."
      }
    }
    \column {
      \line { \bold "KOREAN" }
      \combine \null \vspace #0.3
      \column {
"Yesu sarang Hasiman"
"Georukhasin marilsei"
"Wooridrn Yakana"
"Yesu gwonsei mantoda."
      }
      \combine \null \vspace #0.4
      \column {
"Nal sarang hasim"
"Nal sarang hasim"
"Nal sarang hasim"
"Seong gyongei sseoitne."
      }
      \combine \null \vspace #0.7
      \line { \bold "NAVAJO" }
      \combine \null \vspace #0.3
      \column {
"Jesus ayóó'ashó'ní,"
"Binaaltsoos yee shił halne',"
"Álchíníigi ánísht'é,"
"Doo sidziil da, Ei bidziil."
      }
      \combine \null \vspace #0.4
      \column {
"Jesus ayóó'ashó'ní,"
"Jesus ayoo'ashó'ní,"
"Jesus ayóó'ashó'ní,"
"Bizaad yee shił halne'."
      }
    }
    \hspace #-3.0
  }
}

